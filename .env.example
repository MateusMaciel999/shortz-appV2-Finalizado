# Copie para .env (que NÃO é versionado) e ajuste os valores.
# ATENÇÃO: confira se os nomes abaixo batem com o que config/database.js e app.js leem de process.env.

PORT=3000
NODE_ENV=development

# Segredo da sessão (express-session)
SESSION_SECRET=troque-por-um-valor-longo-e-aleatorio

# Banco MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=shortz
DB_USER=shortz
DB_PASSWORD=troque-esta-senha
